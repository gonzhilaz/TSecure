<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="CustomTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_theme_color</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>

        <item name="android:radioButtonStyle">@style/RadioButtonStyle</item>
        <item name="radioButtonStyle">@style/RadioButtonStyle</item>
        <item name="android:checkboxStyle">@style/CheckboxStyle</item>
        <item name="checkboxStyle">@style/CheckboxStyle</item>
        <item name="switchStyle">@style/SwitchStyle</item>

        <item name="android:dialogTheme">@style/DialogTheme</item>
        <item name="android:colorForeground">@color/primary</item>

        <item name="android:listSeparatorTextViewStyle">@style/SeparatorTextViewStyle</item>
    </style>


    <style name="SeparatorTextViewStyle">
        <item name="android:background">@color/text_color</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">1dp</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowMinWidthMinor">@dimen/dialog_min_width_minor</item>
        <item name="android:windowMinWidthMajor">@dimen/dialog_min_width_major</item>
    </style>

    <style name="RadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:minHeight">@dimen/radio_button_minimum_height</item>
    </style>

    <style name="CheckboxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/checkbox_minimum_height</item>
    </style>

    <style name="SwitchStyle" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:minHeight">@dimen/checkbox_minimum_height</item>
        <item name="android:paddingLeft">@dimen/default_switch_left_padding</item>
    </style>

    <style name="TextSmall">
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="TextMedium">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <style name="TextLarge">
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
    </style>

    <style name="Title" parent="android:Widget.TextView">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">@color/pager_tab_strip_background_color</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="PagerTabStripStyle">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:background">@color/primary</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

</resources>