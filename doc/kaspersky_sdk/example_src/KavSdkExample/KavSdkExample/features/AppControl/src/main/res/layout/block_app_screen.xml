<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/block_app_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/block_app_button"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:textColor="@color/text_color"
        android:text="@string/str_appcontrol_block_app_title"
        style="@style/TextLarge"/>

    <Button
        android:filterTouchesWhenObscured="true"
        android:id="@+id/block_app_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="@string/str_appcontrol_block_app_button" />

</RelativeLayout>
