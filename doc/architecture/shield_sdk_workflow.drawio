        <!-- SECURITY SUMMARY CALLOUT AT BOTTOM -->
        <mxCell id="callout_banner" value="&lt;b&gt;CORE SECURITY ACHIEVEMENTS OF THIS PATTERN:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Team Independence (Bus Factor Solved):&lt;/b&gt; General developers can update UI and screens without access to Kaspersky secrets or bridge sources.&lt;br/&gt;2. &lt;b&gt;Anti-Reverse Engineering:&lt;/b&gt; The compiled APK contains no raw Kaspersky source code; symbols are stripped and binary-obfuscated.&lt;br/&gt;3. &lt;b&gt;Zero-Trust Licensing:&lt;/b&gt; Static keys are eliminated from the client. The SDK only runs with ephemeral tickets from Telkomsel Backend, completely stopping unauthorized license consumption (+1 billing)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C2541;strokeColor=#0B132B;fontColor=#FFFFFF;align=left;spacingLeft=25;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1520" height="80" as="geometry" />
