        <mxCell id="link_ticket_to_active" value="4. Unlock Engine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00C853;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="client_phone" source="phone_init" target="phone_active">
